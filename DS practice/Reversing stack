#include <stdio.h>
#include<stdlib.h>
struct node {
	int data;
	struct node *next;
};

//Pushing element into stack
struct node* push(struct node *top,int a) {
	struct node *newnode=(struct node*)malloc(sizeof(struct node));
	newnode->data=a;
	if(newnode!=NULL) {
		newnode->next=top;
		return newnode;
	}
	else {
		printf("Stack overflow\n");
	}
}

//pop out element from stack
int pop(struct node **top) {
	struct node *temp;
	if(top!=NULL)
	{
		temp=*top;
		int a=temp->data;
		*top=(*top)->next;
		free(temp);
		return a;
	}
	else
		return -1;
}


//To display all elements of stack
void display(struct node *top)
{
	struct node *temp;
	if(top==NULL)
		printf("Stack underflow\n");
	else {
		temp=top;
		while(temp!=NULL) {
			printf("%d\n",temp->data);
			temp=temp->next;
		}
	}
}

int main() {
	struct node *top=NULL,*temp,*top1=NULL;
	//pushing stack in top
	top=push(top,1);
	top=push(top,2);
	top=push(top,3);
	top=push(top,4);
	top=push(top,5);
	display(top);
	
	//pushing reverse stack in top1
    top1=push(top1,pop(&top));
	top1=push(top1,pop(&top));
	top1=push(top1,pop(&top));
	top1=push(top1,pop(&top));
	top1=push(top1,pop(&top));
	display(top1);
	

	return 0;
}
