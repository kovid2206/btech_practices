#include <stdio.h>
#include<stdlib.h>
struct node{
    int data;
    struct node *next;
}*top=NULL,*temp;

//Pushing element into stack
void push(int a){
    struct node *newnode=(struct node*)malloc(sizeof(struct node));
    newnode->data=a;
    if(newnode!=NULL){
        newnode->next=top;
        top=newnode;
    }
    else{
        printf("Stack overflow\n");
    }
}

//pop out element from stack
void pop(){
    if(top==NULL)
        printf("Stack underflow\n");
    else{
        temp=top;
        top=top->next;
        printf("%d is poped out from stack\n",temp->data);
        free(temp);
    }
}

//To display top element of stack
void peek(){
    if(top==NULL)
        printf("Stack underflow\n");
    else
        printf("Top element of stack is :%d\n",top->data);
}

//To display all elements of stack
void display()
{
    if(top==NULL)
        printf("Stack underflow\n");
    else{
   temp=top;
    while(temp!=NULL){
        printf("%d\n",temp->data);
        temp=temp->next;
    }
  }
}
int main() {
    int a,flag=1;
    while(flag!=0){
        printf("---Select one out of the following---\n");
        printf("1.Insert a element in stack\n");
        printf("2.Delete a element in stack\n");
        printf("3.See the top element of stack\n");
        printf("4.Display all element in stack\n");
        printf("Any number for exit\n");
        scanf("%d",&a);
        switch(a){
            case 1:
                int n;
                printf("Give number for push");
                scanf("%d",&n);
                push(n);
                break;
           case 2:
                 pop();
                 break;
            case 3:
                 peek();
                 break;
            case 4:
                 display();
                break;
            default:
                 flag=0;
        }
     }
  return 0;
}
